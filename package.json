    "@openmeteo/file-reader": "0.0.21",
    "@openmeteo/weather-map-layer": "0.3.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/pg": "^8.23.1",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.78.0",
    "maplibre-gl": "^6.19.0",
    "next": "16.4.6",
    "next-intl": "^4.15.3",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "react-map-gl": "^8.1.3",
    "react-markdown": "^10.1.0",
    "remark-parse": "11.0.0",
    "satori": "^0.63.2",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "socket.io-client": "^4.8.4",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.1",
    "unified": "11.0.5",
    "zod": "^4.6.7"
