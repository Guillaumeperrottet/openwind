{
  "name": "openwind",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "wind:audit": "tsx scripts/audit-wind-accuracy.ts",
    "wind:health": "tsx scripts/check-wind-health.ts",
    "wind:tiles:icon-eu": "python3 scripts/build-icon-eu-wind-tiles.py",
    "wind:tiles:publish": "python3 scripts/publish_wind_tiles.py",
    "wind:tiles:test": "python3 -m unittest scripts.test_publish_wind_tiles -v",
    "spots:audit": "node --import tsx scripts/audit-spot-completeness.ts",
    "spots:completions:check": "node --import tsx scripts/import-spot-completions.ts",
    "images:import:commons": "node scripts/import-commons-spot-images.mjs",
    "planner:import:swiss": "tsx scripts/import-swiss-planner-profiles.ts",
    "seo:import:neuchatel": "tsx scripts/import-neuchatel-seo.ts"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.1",
    "@deck.gl/layers": "^9.4.1",
    "@deck.gl/mapbox": "^9.4.1",
